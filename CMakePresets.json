{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 3
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "IBAPI4GU_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux GCC (native Unix sources)",
      "inherits": "linux-base",
      "cacheVariables": {
        "IBAPI4GU_IBKR_DISTRIBUTION": "UNIX"
      }
    },
    {
      "name": "linux-gcc-msi",
      "displayName": "Linux/WSL GCC (Windows sources)",
      "inherits": "linux-base",
      "cacheVariables": {
        "IBAPI4GU_IBKR_DISTRIBUTION": "WINDOWS"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;RelWithDebInfo;Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "IBAPI4GU_IBKR_DISTRIBUTION": "WINDOWS",
        "IBAPI4GU_NTDDI_VERSION": "0x0A000000",
        "IBAPI4GU_WIN32_WINNT": "0x0A00"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC (Ninja Multi-Config)",
      "inherits": "windows-base",
      "generator": "Ninja Multi-Config"
    },
    {
      "name": "windows-vs2026",
      "displayName": "Windows Visual Studio 2026",
      "inherits": "windows-base",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc"
    },
    {
      "name": "linux-gcc-msi",
      "configurePreset": "linux-gcc-msi"
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "windows-vs2026",
      "configurePreset": "windows-vs2026",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "linux-gcc",
      "configurePreset": "linux-gcc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc-msi",
      "configurePreset": "linux-gcc-msi",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-vs2026",
      "configurePreset": "windows-vs2026",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "linux-gcc",
      "steps": [
        { "type": "configure", "name": "linux-gcc" },
        { "type": "build", "name": "linux-gcc" },
        { "type": "test", "name": "linux-gcc" }
      ]
    },
    {
      "name": "linux-gcc-msi",
      "steps": [
        { "type": "configure", "name": "linux-gcc-msi" },
        { "type": "build", "name": "linux-gcc-msi" },
        { "type": "test", "name": "linux-gcc-msi" }
      ]
    },
    {
      "name": "windows-msvc",
      "steps": [
        { "type": "configure", "name": "windows-msvc" },
        { "type": "build", "name": "windows-msvc" },
        { "type": "test", "name": "windows-msvc" }
      ]
    },
    {
      "name": "windows-vs2026",
      "steps": [
        { "type": "configure", "name": "windows-vs2026" },
        { "type": "build", "name": "windows-vs2026" },
        { "type": "test", "name": "windows-vs2026" }
      ]
    }
  ]
}
