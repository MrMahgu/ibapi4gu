{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "IBAPI4GU_BUILD_EXAMPLES": "ON",
        "IBAPI4GU_CXX_STANDARD": "26"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-gcc-pb3",
      "displayName": "Linux/WSL GCC (Protobuf 3.12.4)",
      "inherits": "linux-base",
      "cacheVariables": {
        "IBAPI4GU_IBKR_DISTRIBUTION": "UNIX",
        "IBAPI4GU_IBKR_GENERATION": "STABLE"
      }
    },
    {
      "name": "linux-gcc-pb5",
      "displayName": "Linux/WSL GCC (Protobuf 5.29.5)",
      "inherits": "linux-base",
      "cacheVariables": {
        "IBAPI4GU_IBKR_DISTRIBUTION": "WINDOWS",
        "IBAPI4GU_IBKR_GENERATION": "STABLE"
      }
    },
    {
      "name": "linux-gcc-pb6",
      "displayName": "Linux/WSL GCC (Protobuf 6.33.4)",
      "inherits": "linux-base",
      "cacheVariables": {
        "IBAPI4GU_IBKR_DISTRIBUTION": "WINDOWS",
        "IBAPI4GU_IBKR_GENERATION": "FUTURE"
      }
    },
    {
      "name": "linux-gcc-pb7",
      "displayName": "Linux/WSL GCC (Protobuf 7.36.1)",
      "inherits": "linux-base",
      "cacheVariables": {
        "IBAPI4GU_IBKR_DISTRIBUTION": "UNIX",
        "IBAPI4GU_IBKR_GENERATION": "FUTURE"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;RelWithDebInfo;Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "IBAPI4GU_IBKR_DISTRIBUTION": "WINDOWS",
        "IBAPI4GU_IBKR_GENERATION": "STABLE",
        "IBAPI4GU_NTDDI_VERSION": "0x0A000000",
        "IBAPI4GU_WIN32_WINNT": "0x0A00"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC (Ninja Multi-Config)",
      "inherits": "windows-base",
      "generator": "Ninja Multi-Config"
    },
    {
      "name": "windows-vs2026",
      "displayName": "Windows Visual Studio 2026",
      "inherits": "windows-base",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-gcc-pb3",
